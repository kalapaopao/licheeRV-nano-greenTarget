# 构建产物（RISC-V 交叉编译：产物名 camera）
build/
build_host/
*.o
*.a

# 视频与录像
recordings/
*.avi
.camera.lock/

# 一次飞行一个文件夹（视频 + CSV + meta，数据不入库）
record/
logs/

# 运行状态历史（run_history.log 是本机运行痕迹，不入库）
state/

# 日志
*.log

# 测试产生的中间帧
tests/*.i420

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# draw.io 桌面版的备份/临时文件
$*.bkp
*.drawio.bkp
~$*.drawio

# 第三方参考项目（各自独立 git 仓库，不参与本工程编译）
third_party/

# 不再使用手工 *.bak 备份：回退一律靠 git（见 README「开发约定」）
*.bak
*.bak_*
backup/
