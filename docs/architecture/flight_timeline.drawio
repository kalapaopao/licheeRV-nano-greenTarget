<mxfile host="Electron" type="device"><diagram name="一次飞行的时间线" id="flight-timeline"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="① 通电&lt;br&gt;start.sh 监督进程&lt;br&gt;切 36MHz 时钟 · 相机锁 · 温度检查 · 校验 config" vertex="1"><mxGeometry height="70" width="440" x="120" y="40" as="geometry" /></mxCell><mxCell id="t2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="② camera 启动&lt;br&gt;VI/ISP/VENC 就绪&lt;br&gt;写 run_history：tag=ready" vertex="1"><mxGeometry height="70" width="440" x="120" y="150" as="geometry" /></mxCell><mxCell id="t3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="③ 待机预录（不写盘）&lt;br&gt;每帧 on_frame 进环形缓冲（≈11s）&lt;br&gt;电控 100Hz 帧进同一条缓冲" vertex="1"><mxGeometry height="70" width="440" x="120" y="260" as="geometry" /></mxCell><mxCell id="t4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;rounded=1;arcSize=8;" value="④ 电控 STATE：STATIC → FLIGHT" vertex="1"><mxGeometry height="56" width="440" x="120" y="370" as="geometry" /></mxCell><mxCell id="t5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="⑤ 开一段会话&lt;br&gt;把前 3s 预录整体落盘，之后实时写" vertex="1"><mxGeometry height="70" width="440" x="120" y="466" as="geometry" /></mxCell><mxCell id="t6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;rounded=1;arcSize=8;" value="⑥ 电控 STATE：FLIGHT → STOP" vertex="1"><mxGeometry height="56" width="440" x="120" y="576" as="geometry" /></mxCell><mxCell id="t7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;roun