<mxfile host="Electron" type="device"><diagram name="一行数据的一生" id="row-life"><mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="r1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E8E1F2;strokeColor=#7030A0;rounded=1;arcSize=8;" value="① 电控第 93 帧到达板子&lt;br&gt;&lt;b&gt;rx_us = 852982879 µs&lt;/b&gt;（这是电控数据的时刻）" vertex="1"><mxGeometry height="80" width="560" x="150" y="40" as="geometry" /></mxCell><mxCell id="r2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E8E1F2;strokeColor=#7030A0;rounded=1;arcSize=8;" value="② 串口线程解析 → 加锁写共享快照&lt;br&gt;{state, flags, roll…gz, rx_us}" vertex="1"><mxGeometry height="80" width="560" x="150" y="150" as="geometry" /></mxCell><mxCell id="r3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="③ 主线程取到一帧（VI 出图）&lt;br&gt;&lt;b&gt;capture_us = 852990741 µs&lt;/b&gt;（这是画面的时刻）" vertex="1"><mxGeometry height="80" width="560" x="150" y="270" as="geometry" /></mxCell><mxCell id="r4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="④ &lt;b&gt;立刻&lt;/b&gt;加锁读快照 → 拿到第 93 帧&lt;br&gt;记下 mcu_rx_us=852982879、age=&lt;b&gt;7862 µs&lt;/b&gt;" vertex="1"><mxGeometry height="80" width="560" x="150" y="380" as="geometry" /></mxCell><mxCell id="r5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2F5597;rounded=1;arcSize=8;" value="⑤ 检测 7.1 ms → 组一行文本&lt;br&gt;22 个视觉列 + 9 个电控列 + 2 个时刻列" vertex="1"><mxGeometry height="80" width="560" x="150" y="500" as="geometry" /></mxCell><mxCell id="r6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;rounded=1;arcSize=8;" value="⑥ memcpy 进环形缓冲（微秒级，不碰磁盘）&lt;br&gt;队列里放的是「已经拼好的一行字符串」" vertex="1"><mxGeometry height="80" width="560" x="150" y="610" as="geometry" /></mxCell><mxCell id="r7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#DAEEF3;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="⑦ 写线程 write() → frames.csv&lt;br&gt;&lt;b&gt;只搬运，不加任何时刻&lt;/b&gt;（晚 20 ms 也不改 age）" vertex="1"><mxGeometry height="80" width="560" x="150" y="720" as="geometry" /></mxCell><mxCell id="s2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="共享快照 = 类成员变量 + 一把 mutex&lt;br&gt;（不是 static，效果等价：全局唯一状态）" vertex="1"><mxGeometry height="90" width="380" x="770" y="155" as="geometry" /></mxCell><mxCell id="s4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="为什么必须「立刻」读：&lt;br&gt;等检测（5~20ms）之后再读，&lt;br&gt;期间新到的电控帧会被算进这一帧&lt;br&gt;（实测会新 0~9ms，中位 6ms）" vertex="1"><mxGeometry height="150" width="380" x="770" y="380" as="geometry" /></mxCell><mxCell id="s6" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="环形缓冲 2048 行（≈11s）&lt;br&gt;写盘跟不上：待机丢最旧、会话中丢最新&lt;br&gt;并计数 dropped" vertex="1"><mxGeometry height="130" width="380" x="770" y="610" as="geometry" /></mxCell><mxCell id="s7" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="所以：一行的“新旧”只看 mcu_age_ms，&lt;br&gt;与磁盘什么时候写完无关" vertex="1"><mxGeometry height="120" width="380" x="770" y="720" as="geometry" /></mxCell><mxCell id="e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#7030A0;strokeWidth=2;" edge="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#7030A0;strokeWidth=2;" edge="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#2F5597;strokeWidth=2;" edge="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#2F5597;strokeWidth=2;" edge="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#BF9000;strokeWidth=2;" edge="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#BF9000;strokeWidth=2;" edge="1" source="r6" target="r7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="sum" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FDE9E0;strokeColor=#C55A11;rounded=1;arcSize=8;" value="【结论】一行只有两个时刻：画面 capture_us、电控 mcu_rx_us；差值 = mcu_age_ms（这一行标着 7862 µs）。&lt;br&gt;还有两个「不知道」的偏移：曝光时刻比 capture_us 早 5~15 ms（未标定）；电控采样时刻比 rx_us 早 3~13 ms（传输+周期）。&lt;br&gt;要消掉后两个，只能靠：① 闪灯标定曝光延迟；② 电控在帧里带自己的时间戳（TLV 提案 TAG 0x01）。" vertex="1"><mxGeometry height="130" width="1080" x="150" y="860" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>