光模式；80fps 用 auto 图像正常" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="655" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n8" value="manual_exposure_us" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="693" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n9" value="3000" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="693" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n10" value="手动曝光微秒数" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="693" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n11" value="black_level_mode" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="731" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n12" value="default | manual" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="731" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n13" value="黑电平；default 与原版一致" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="731" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n14" value="jpeg_quality" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSp