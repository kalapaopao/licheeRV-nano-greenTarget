帧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="slot" target="enc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e13" value="swap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enc" target="latest"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e14" value="复用码流" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enc" target="avi"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e15" value="调用硬件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#6c8ebf;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="enc" target="venc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="srv" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="cli" target="ep"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e18" value="读最新 JPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#6c8ebf;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="latest" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e19" value="HTTP MJPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;strokeColor=#82b366;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ep" target="browser"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="avi" target="vlc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e21" value="printf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#82b366;strokeColor=#82b366;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="track" target="log"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_n0" value="YAML 开关&lt;br&gt;&lt;br&gt;record_enable : 每次启动自动录像&lt;br&gt;display_enable : 关掉编码+网页&lt;br&gt;detect_enable : 关掉检测&lt;br&gt;web_ip : auto/usb/wifi&lt;br&gt;detect_sample_steps : 1..4&lt;br&gt;detect_stride : 每 N 帧检测&lt;br&gt;run_seconds : 0 = 常驻" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="210" height="300" as="geometry" /></mxCell><mxCell id="_n1" value="保护阈值&lt;br&gt;70°C 禁止启动 / 74.5°C 停机" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="50" y="990" width="210" height="70" as="geometry" /></mxCell><mxCell id="_n2" value="硬件 / 驱动层（CVITEK 中间件，内核态 + 用户态驱动）" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="105" width="860" height="26" as="geometry" /></mxCell><mxCell id="_n3" value="驱动：src/sensor/&lt;br&gt;用户态 GC4653&lt;br&gt;（含 720P 寄存器表）" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="180" height="76" as="geometry" /></mxCell><mxCell id="_n4" value="① 主线程（采集 + 检测 + 画框，每帧内联）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="245" width="860" height="26" as="geometry" /></mxCell><mxCell id="_n5" value="② encoder_worker（消费者，display_enable=false 时不启动）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="490" width="860" height="26" as="geometry" /></mxCell><mxCell id="_n6" value="③ http_server + http_client（4 个客户端槽）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="860" height="26" as="geometry" /></mxCell><mxCell id="_n7" value="实测（板端）&lt;br&gt;&lt;br&gt;VI: 1280x720 NV12&lt;br&gt;host_fps  80.08&lt;br&gt;pts_fps   80.08&lt;br&gt;encode_fps 79.60&lt;br&gt;DETECT 5.30ms&lt;br&gt;  ├ sample 4.49ms&lt;br&gt;  └ track  0.80ms&lt;br&gt;颜色 R120/G111/B112&lt;br&gt;&lt;br&gt;检测每帧都跑（stride=1）" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="440" width="350" height="300" as="geometry" /></mxCell><mxCell id="_n8" value="关键取舍&lt;br&gt;&lt;br&gt;• 检测内联在主线程，不单开线程：&lt;br&gt;  5.3ms &lt; 12.5ms 帧预算&lt;br&gt;• 深度 1 覆盖槽：宁丢旧帧，&lt;br&gt;  不排队累积延迟&lt;br&gt;• JPEG 只编码一次：&lt;br&gt;  网页 / 抓图 / 录像三处复用&lt;br&gt;• VENC 是硬件电路，不抢 CPU" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1240" y="760" width="350" height="270" as="geometry" /></mxCell><mxCell id="_n9" value="线程清单：① 主线程（取帧+检测+画框）  ② encoder_worker  ③ http_server  ④ http_client × ≤4&lt;br&gt;同步原语：input_mutex（帧交接） / jpeg_mutex（最新 JPEG） / running（atomic&lt;int&gt;，信号退出）&lt;br&gt;共享数据：pending（深度1帧槽） / latest + generation（JPEG） / g_va[16]（mmap 缓存） / avi&lt;br&gt;&lt;br&gt;退出路径：SIGINT/SIGTERM → running=0 → 各线程退出 → join → VENC DestroyChn → VI/ISP Destroy → SYS_Exit → 时钟恢复" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="790" width="860" height="250" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="2-逐帧流水线" name="2-逐帧流水线"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_title" value="主线程逐帧流水线（含耗时与开关）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1574" height="34" as="geometry" /></mxCell><mxCell id="_sub" value="每 12.5ms 一帧 | 检测占 5.30ms | 所有分支都可通过 YAML / 环境变量控制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1574" height="24" as="geometry" /></mxCell><mxCell id="_band0" value="主循环 while(running) — 顺序执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#9673a6;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1100" height="1000" as="geometry" /></mxCell><mxCell id="_band1" value="控制开关 / 实测数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#d6b656;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1150" y="80" width="470" height="1000" as="geometry" /></mxCell><mxCell id="s1" value="1. CVI_VI_GetChnFrame(0,0,&amp;frame,1000)&lt;br&gt;超时 1000ms → 计 timeouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="230" height="66" as="geometry" /></mxCell><mxCell id="s2" value="2. 一次性设置（t-start&gt;2）&lt;br&gt;曝光 / 黑电平 / 打印 AE_INFO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="230" height="66" as="geometry" /></mxCell><mxCell id="s3" value="3. 前 4 秒丢弃&lt;br&gt;if(t-start&lt;4) 直接 Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="130" width="230" height="66" as="geometry" /></mxCell><mxCell id="s4" value="4. 首帧打印 VI geometry&lt;br&gt;尺寸/stride/length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="225" height="66" as="geometry" /></mxCell><mxCell id="s5" value="5. mmap 缓存&lt;br&gt;VirAddr 为空 → map_cached()&lt;br&gt;CVI_SYS_MmapCache(phy,len)&lt;br&gt;命中 g_va[16] 直接复用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="235" width="230" height="84" as="geometry" /></mxCell><mxCell id="s6" value="6. 抽点下采样  sample 4.49ms&lt;br&gt;S=4 → 320x180 网格&lt;br&gt;每个 S×S 块内 ns×ns 取最大值&lt;br&gt;gy[320*180], gu/gv[160*90]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="235" width="230" height="84" as="geometry" /></mxCell><mxCell id="s7" value="7. 检测  track 0.80ms&lt;br&gt;g_tracker.process(gy,gu,gv,w,h)&lt;br&gt;返回 TrackState&lt;br&gt;(cx, cy, radius, status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="235" width="230" height="84" as="geometry" /></mxCell><mxCell id="s8" value="8. 画框（display_on 且命中）&lt;br&gt;坐标 × S 映射回全分辨率&lt;br&gt;Y 平面写 255（3px 白框）&lt;br&gt;IonFlushCache 写回 DRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="235" width="225" height="84" as="geometry" /></mxCell><mxCell id="s9" value="9. 日志输出&lt;br&gt;GREEN_TARGET（每60帧/首次）&lt;br&gt;GREEN_STAT（每300帧）&lt;br&gt;hits / rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="360" width="230" height="76" as="geometry" /></mxCell><mxCell id="s10" value="10. 帧交接&lt;br&gt;if display_on → pending 槽&lt;br&gt;（覆盖旧帧 preview_replaced++）&lt;br&gt;else → 直接 Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="230" height="76" as="geometry" /></mxCell><mxCell id="s11" value="11. 每 5 秒统计&lt;br&gt;capture_frames / host_fps&lt;br&gt;DETECT avg_ms / CLOCK36_WINDOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="360" width="230" height="76" as="geometry" /></mxCell><mxCell id="s12" value="12. 回到 1.&lt;br&gt;直到 running=0&lt;br&gt;（SIGINT/SIGTERM）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="225" height="76" as="geometry" /></mxCell><mxCell id="_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e3" value="取帧后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e11" value="下一帧" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#9673a6;strokeColor=#9673a6;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s12" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_n0" value="分支与短路&lt;br&gt;&lt;br&gt;detect_enable=false   → 跳过 5~9 步，帧直接交给 pending（纯取流，A/B 实测 33.83 vs 33.69 fps，检测不是瓶颈）&lt;br&gt;display_enable=false  → 不创建 VENC / encoder_thread / http_server；第 10 步直接 CVI_VI_ReleaseChnFrame&lt;br&gt;detect_stride=N       → 每 N 帧才做一次 5~9 步（N=2 时检测 40 次/秒）&lt;br&gt;DRAW_TEST_BOX=1       → 第 8 步改画固定调试框，用来验证「画框+缓存刷新→JPEG可见」链路，无需真实目标" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="470" width="1050" height="200" as="geometry" /></mxCell><mxCell id="_n1" value="为什么这样设计&lt;br&gt;&lt;br&gt;• 检测内联而非独立线程：5.3ms 塞得进 12.5ms 帧预算；拆线程只会增加锁与切换开销&lt;br&gt;• mmap 必须缓存：未缓存的 CMA 每字节访问都走总线，实测 223ms/帧（4fps）；缓存映射后 28ms → 优化采样后 5.3ms&lt;br&gt;• 最大池化而非单点抽样：发光目标是很小的亮斑，单点抽样（覆盖率 6%）容易整个跳过&lt;br&gt;• pending 槽深度 1：检测与编码只关心最新画面，排队旧帧只会累积延迟&lt;br&gt;• 画框必须在编码前写进 Y 平面并用 IonFlushCache 刷回：否则硬件 VENC 读的是旧数据，网页看不到框" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="690" width="1050" height="210" as="geometry" /></mxCell><mxCell id="_n2" value="实测耗时分解（1280x720 @ 80fps, detect_sample_steps=1）&lt;br&gt;&lt;br&gt;sample_ms 4.49  |  track_ms 0.80  |  DETECT 合计 5.30 ms  |  帧预算 12.50 ms  |  余量 57%" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="920" width="1050" height="130" as="geometry" /></mxCell><mxCell id="_n3" value="检测参数（config.yaml）&lt;br&gt;&lt;br&gt;detect_enable: true&lt;br&gt;detect_sample_steps: 1   ← 保持80fps的关键&lt;br&gt;detect_stride: 1&lt;br&gt;&lt;br&gt;阈值（green_detect.h）&lt;br&gt;y_min=100  sat_min=30&lt;br&gt;u_max=124  v_max=124&lt;br&gt;area 2..400  fill&gt;=0.50&lt;br&gt;aspect&lt;=2.20  radius&lt;=12" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1175" y="130" width="420" height="260" as="geometry" /></mxCell><mxCell id="_n4" value="采样密度 ↔ 帧率（实测）&lt;br&gt;&lt;br&gt;ns=1  DETECT 7.5→5.3ms   80.1fps ✓&lt;br&gt;ns=2  DETECT 16.4ms       40.0fps ✗&lt;br&gt;ns=2 stride=2             53.3fps ✗&lt;br&gt;ns=4  DETECT 27ms         20.5fps ✗&lt;br&gt;&lt;br&gt;结论：满帧检测只能用 ns=1；&lt;br&gt;远处小目标需改两级检测（先粗扫，&lt;br&gt;发现可疑再局部加密），尚未实现。" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1175" y="410" width="420" height="290" as="geometry" /></mxCell><mxCell id="_n5" value="输出关键词（日志）&lt;br&gt;&lt;br&gt;SENSOR_MODE 720P_60FPS size=1280x720&lt;br&gt;POOL_SIZE 1280x720&lt;br&gt;VI geometry=1280x720&lt;br&gt;GREEN_STAT frames=2100 hits=0 rate=0.0%&lt;br&gt;GREEN_TARGET status=detected cx=.. cy=.. r=..&lt;br&gt;DETECT avg_ms=5.299 ... ns=1&lt;br&gt;capture_frames=2084 host_fps=80.0794" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1175" y="720" width="420" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="3-绿色检测算法" name="3-绿色检测算法"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_title" value="绿色发光圆灯检测 — 算法内部（纯 C++11）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1574" height="34" as="geometry" /></mxCell><mxCell id="_sub" value="src/green_detect.{h,cpp} | 无 OpenCV / 无 NPU / 无每帧动态分配 | Python 参考实现的等价移植" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1574" height="24" as="geometry" /></mxCell><mxCell id="_band0" value="算法流水线（在 320x180 检测网格上运行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#d79b00;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1180" height="1000" as="geometry" /></mxCell><mxCell id="_band1" value="设计要点 / 参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#d6b656;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1230" y="80" width="390" height="1000" as="geometry" /></mxCell><mxCell id="a0" value="输入：三平面网格&lt;br&gt;gy[320x180] 亮度&lt;br&gt;gu/gv[160x90] 色度&lt;br&gt;（来自 NV12，UV 交织已拆开）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="230" height="76" as="geometry" /></mxCell><mxCell id="a1" value="① buildMask 颜色判据&lt;br&gt;Y &gt; y_min(100)&lt;br&gt;U &lt; 124 且 V &lt; 124&lt;br&gt;sat = √(du²+dv²) ≥ 30&lt;br&gt;门控内可用回退阈值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="130" width="230" height="88" as="geometry" /></mxCell><mxCell id="a2" value="② morphOpen&lt;br&gt;3×3 形态学开运算&lt;br&gt;腐蚀 + 膨胀&lt;br&gt;去掉孤立噪点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="130" width="230" height="88" as="geometry" /></mxCell><mxCell id="a3" value="③ 8 连通域标记&lt;br&gt;显式栈（非递归）&lt;br&gt;mask_ / stack_ 复用 vector&lt;br&gt;统计 bbox / 面积 / 像素数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="300" height="88" as="geometry" /></mxCell><mxCell id="a4" value="④ 形状过滤&lt;br&gt;面积 2..400&lt;br&gt;填充率 ≥ 0.50&lt;br&gt;长宽比 ≤ 2.20&lt;br&gt;等效半径 ≤ 12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="265" width="230" height="96" as="geometry" /></mxCell><mxCell id="a5" value="⑤ 候选评分&lt;br&gt;亮度 + 饱和度 − 距离&lt;br&gt;选最优 Blob&lt;br&gt;(mask_pixels_ 统计)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="265" width="230" height="96" as="geometry" /></mxCell><mxCell id="a6" value="⑥ 最近邻跟踪 + 门控&lt;br&gt;gate_px / max_jump_px&lt;br&gt;预测 + 关联&lt;br&gt;允许 coast 短暂丢失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="265" width="230" height="96" as="geometry" /></mxCell><mxCell id="a7" value="⑦ 三态状态机&lt;br&gt;Detected  命中&lt;br&gt;Coast     短暂跟丢（保持输出）&lt;br&gt;Lost      彻底丢失（不输出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="265" width="300" height="96" as="geometry" /></mxCell><mxCell id="a8" value="⑧ TrackState&lt;br&gt;status / cx / cy&lt;br&gt;blob.radius / misses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="405" width="230" height="76" as="geometry" /></mxCell><mxCell id="a9" value="⑨ 坐标 × S 映射&lt;br&gt;网格坐标 → 全分辨率&lt;br&gt;(1280x720)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="605" y="405" width="230" height="76" as="geometry" /></mxCell><mxCell id="a10" value="⑩ 两个去处&lt;br&gt;日志 GREEN_TARGET&lt;br&gt;Y 平面画白框 → JPEG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="880" y="405" width="300" height="76" as="geometry" /></mxCell><mxCell id="_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#333333;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_n0" value="为什么直接在 YUV 域判断，不转 RGB / HSV&lt;br&gt;&lt;br&gt;Python 参考实现用 HSV（H 35~85、S&gt;60、V&gt;120）。板端帧是 NV12（Y 平面 + UV 交织），转色彩空间要额外一次全图遍历。&lt;br&gt;等价判据：U&lt;128 且 V&lt;128 就是「偏绿」方向；sat=√((U-128)²+(V-128)²) 等价饱和度；Y 等价亮度。&lt;br&gt;关键性质：判据同时要求 U 和 V 都小于阈值，与 UV 字节顺序（NV12 的 UVUV / NV21 的 VUVU）无关，所以不需要猜格式。&lt;br&gt;回退阈值（更松的 sat / Y）只在跟踪门控圆内启用，避免满屏误报。" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="520" width="1125" height="230" as="geometry" /></mxCell><mxCell id="_n1" value="与 Python 原版的对应关系 / 已验证事实&lt;br&gt;&lt;br&gt;• 阈值按 1/4 缩放：1280x720 → 320x180 网格（S=4），面积/半径/门限同步缩放&lt;br&gt;• 跟踪结构：预测 → 门控关联 → coast（连续 N 帧保持）→ lost，对应原版的 gate+coast+misses&lt;br&gt;• 板端验证：detect_cli 静态二进制对真实帧输出 (621.4, 251.1)，与 Python 版差 2px；单帧 2.25ms（RISC-V 1GHz）&lt;br&gt;• 无目标帧验证：mask_px=0 / status=LOST，无误报&lt;br&gt;• 无每帧堆分配：mask_ 用 assign 复用，连通域用显式栈，适合长期运行" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="770" width="1125" height="270" as="geometry" /></mxCell><mxCell id="_n2" value="Config 默认值&lt;br&gt;&lt;br&gt;y_min = 100&lt;br&gt;sat_min = 30&lt;br&gt;y_fallback = 60&lt;br&gt;sat_fallback = 25&lt;br&gt;u_max = 124&lt;br&gt;v_max = 124" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1255" y="130" width="340" height="230" as="geometry" /></mxCell><mxCell id="_n3" value="形状 / 跟踪参数&lt;br&gt;&lt;br&gt;area_min = 2&lt;br&gt;area_max = 400&lt;br&gt;fill_min = 0.50&lt;br&gt;aspect_max = 2.20&lt;br&gt;radius_max = 12&lt;br&gt;gate_px = 28&lt;br&gt;max_jump_px = 38&lt;br&gt;coast_frames = 20" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1255" y="380" width="340" height="250" as="geometry" /></mxCell><mxCell id="_n4" value="实测（当前画面无目标）&lt;br&gt;&lt;br&gt;GREEN_STAT frames=2100&lt;br&gt;hits=0 rate=0.0%&lt;br&gt;→ 无误报，判据正常&lt;br&gt;&lt;br&gt;命中时输出：&lt;br&gt;GREEN_TARGET&lt;br&gt;  status=detected&lt;br&gt;  cx / cy / r（全分辨率）" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1255" y="650" width="340" height="200" as="geometry" /></mxCell><mxCell id="_n5" value="尚未验证&lt;br&gt;&lt;br&gt;真实绿色目标在不同距离、&lt;br&gt;不同环境光下的检出率，&lt;br&gt;需要你放目标实测。&lt;br&gt;&lt;br&gt;ns=1 时每 4x4 块只取 1 点，&lt;br&gt;远处小目标可能漏检。" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1255" y="870" width="340" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="4-启动与配置" name="4-启动与配置"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_title" value="开机启动链路 + YAML 配置全表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1574" height="34" as="geometry" /></mxCell><mxCell id="_sub" value="通电 → 约 15 秒后浏览器可直接看到画面，无需 SSH 敲命令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1574" height="24" as="geometry" /></mxCell><mxCell id="_band0" value="开机时序（串行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#9673a6;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1000" height="480" as="geometry" /></mxCell><mxCell id="_band1" value="YAML 参数（config.yaml 手动测试 / config_boot.yaml 开机自启）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#d6b656;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1000" height="500" as="geometry" /></mxCell><mxCell id="_band2" value="网络与验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#82b366;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1050" y="80" width="570" height="1000" as="geometry" /></mxCell><mxCell id="p1" value="1. 通电 / 内核启动&lt;br&gt;Buildroot sysvinit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="180" height="66" as="geometry" /></mxCell><mxCell id="p2" value="2. S30wifi&lt;br&gt;wpa_supplicant&lt;br&gt;udhcpc 拿 IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="180" height="66" as="geometry" /></mxCell><mxCell id="p3" value="3. S99flycamera&lt;br&gt;轮询 wlan0 最多 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="485" y="130" width="180" height="66" as="geometry" /></mxCell><mxCell id="p4" value="4. AUTO_BOOT=1 sh start.sh&lt;br&gt;选 config_boot.yaml&lt;br&gt;run_seconds=0 常驻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="300" height="66" as="geometry" /></mxCell><mxCell id="p5" value="5. 校验配置&lt;br&gt;拒绝未知/重复键&lt;br&gt;嵌套 YAML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="235" width="180" height="76" as="geometry" /></mxCell><mxCell id="p6" value="6. 前置检查&lt;br&gt;温度 &lt;70°C&lt;br&gt;时钟=原始值&lt;br&gt;相机锁空闲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="270" y="235" width="180" height="76" as="geometry" /></mxCell><mxCell id="p7" value="7. 切 36MHz&lt;br&gt;devmem 0x030028c4&lt;br&gt;= 0x00210001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="485" y="235" width="180" height="76" as="geometry" /></mxCell><mxCel