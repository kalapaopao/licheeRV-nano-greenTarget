<mxfile host="app.diagrams.net" modified="2026-11-06T00:00:00.000Z" agent="DSH" version="24.0" type="device"><diagram id="1-总体架构" name="1-总体架构"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_title" value="LicheeRV Nano 绿色目标识别 — 总体架构" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1574" height="34" as="geometry" /></mxCell><mxCell id="_sub" value="单进程 + 4 类线程 | 1280x720 @ 80fps | 纯传统算法（无 NPU / 无 OpenCV）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1574" height="24" as="geometry" /></mxCell><mxCell id="_band0" value="① 配置与监督层（进程外）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#d6b656;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="250" height="1000" as="geometry" /></mxCell><mxCell id="_band1" value="② camera 单进程（工作主体）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#9673a6;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#9673a6;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="900" height="1000" as="geometry" /></mxCell><mxCell id="_band2" value="③ 展示 / 消费端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#82b366;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="400" height="1000" as="geometry" /></mxCell><mxCell id="boot" value="S99flycamera&lt;br&gt;开机自启（等 wlan0 拿到 IP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="210" height="62" as="geometry" /></mxCell><mxCell id="cfg" value="config_boot.yaml  /  config.yaml&lt;br&gt;YAML 平铺键值（严格校验）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="210" height="76" as="geometry" /></mxCell><mxCell id="start" value="start.sh（监督脚本）&lt;br&gt;解析/校验 YAML → 相机锁&lt;br&gt;36MHz 时钟 → 启动 camera&lt;br&gt;温度/MIPI/时钟守护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="324" width="210" height="96" as="geometry" /></mxCell><mxCell id="env" value="环境变量传给 camera&lt;br&gt;RECORD80_* / WEB_IP_BIND&lt;br&gt;DISPLAY_ENABLE / DETECT_*&lt;br&gt;MAIX_SENSOR_FPS=80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="448" width="210" height="96" as="geometry" /></mxCell><mxCell id="stop" value="stop.sh&lt;br&gt;正常停止 → 恢复时钟/释放锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="50" y="572" width="210" height="62" as="geometry" /></mxCell><mxCell id="sensor" value="GC4653 传感器&lt;br&gt;720P_60FPS 模式&lt;br&gt;MCLK 37.125MHz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="190" height="76" as="geometry" /></mxCell><mxCell id="vi" value="VI 视频输入&lt;br&gt;NV12 1280x720&lt;br&gt;VB 池 8 块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="550" y="140" width="190" height="76" as="geometry" /></mxCell><mxCell id="venc" value="VENC 硬件编码器&lt;br&gt;JPEG Q85（专用电路）&lt;br&gt;不占 CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="140" width="190" height="76" as="geometry" /></mxCell><mxCell id="get" value="CVI_VI_GetChnFrame&lt;br&gt;取一帧 NV12（零拷贝）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="285" width="190" height="66" as="geometry" /></mxCell><mxCell id="mmap" value="map_cached()&lt;br&gt;CVI_SYS_MmapCache&lt;br&gt;16 项 phy→va 缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="550" y="285" width="190" height="66" as="geometry" /></mxCell><mxCell id="sample" value="抽点下采样&lt;br&gt;1280x720 → 320x180&lt;br&gt;ns×ns 最大池化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="285" width="190" height="66" as="geometry" /></mxCell><mxCell id="track" value="greendet::Tracker&lt;br&gt;YUV 判据 → 连通域&lt;br&gt;→ 形状过滤 → 跟踪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="385" width="190" height="76" as="geometry" /></mxCell><mxCell id="draw" value="Y 平面画白框&lt;br&gt;3px 矩形 + IonFlushCache&lt;br&gt;（编码前，非网页叠加）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="550" y="385" width="190" height="76" as="geometry" /></mxCell><mxCell id="slot" value="pending 槽（深度 1）&lt;br&gt;input_mutex 保护&lt;br&gt;新帧覆盖旧帧，不排队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="385" width="190" height="76" as="geometry" /></mxCell><mxCell id="enc" value="CVI_VENC_StartRecvFrame&lt;br&gt;→ SendFrame → GetStream&lt;br&gt;拼出 JPEG 码流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="530" width="190" height="76" as="geometry" /></mxCell><mxCell id="latest" value="latest + generation&lt;br&gt;（jpeg_mutex 保护）&lt;br&gt;多个客户端共享一份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="550" y="530" width="190" height="76" as="geometry" /></mxCell><mxCell id="avi" value="AviMjpegWriter&lt;br&gt;record_enable=true&lt;br&gt;同一份 JPEG 直接写盘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="530" width="190" height="76" as="geometry" /></mxCell><mxCell id="srv" value="http_server&lt;br&gt;accept → 分配空闲槽&lt;br&gt;满则返回 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#