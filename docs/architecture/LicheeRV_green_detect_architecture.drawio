<mxCell id="_n22" value="★每次启动自动录像，无需 --recoding" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="845" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n23" value="display_enable" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="883" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n24" value="true | false" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="883" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n25" value="★关掉 VENC + 网页（实战降温）" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="883" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n26" value="detect_enable" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="921" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n27" value="true | false" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="921" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n28" value="★关掉绿色检测（纯取流对照）" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="921" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n29" value="detect_sample_steps" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="959" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n30" value="1" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="959" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n31" value="★块内采样密度；1 才能保 80fps" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="959" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n32" value="detect_stride" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="997" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n33" value="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="997" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n34" value="每 N 帧检测一次" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="997" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n35" value="web_ip" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="1035" width="300" height="34" as="geometry" /></mxCell><mxCell id="_n36" value="auto | usb | wifi" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365" y="1035" width="200" height="34" as="geometry" /></mxCell><mxCell id="_n37" value="★绑定地址；auto=0.0.0.0 全网卡" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="575" y="1035" width="425" height="34" as="geometry" /></mxCell><mxCell id="_n38" value="板端三个网卡地址&lt;br&gt;&lt;br&gt;usb1  10.133.124.1  ← USB 线连接&lt;br&gt;usb0  10.133.125.1&lt;br&gt;wlan0 172.20.162.241 ← Wi-Fi&lt;br&gt;&lt;br&gt;服务绑定 0.0.0.0:8081（auto），三种地址都能访问。" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="130" width="520" height="200" as="geometry" /></mxCell><mxCell id="_n39" value="浏览器地址（实测）&lt;br&gt;&lt;br&gt;✔ http://10.133.124.1:8081/        （USB）&lt;br&gt;✔ http://licheervnano-857c.local:8081/ （无线 mDNS）&lt;br&gt;△ http://172.20.162.241:8081/  （Wi-Fi IP，电脑侧 VPN 虚拟网卡会抢路由，可能超时）" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1075" y="350" width="520" height="210" as="geometry" /></mxCell><mxCell id="_n40" value="接口&lt;br&gt;&lt;br&gt;GET /              → 内嵌 HTML 页面&lt;br&gt;GET /live.mjpg     → MJPEG 实时流&lt;br&gt;GET /snapshot.jpg  → 单帧抓图&lt;br&gt;&lt;br&gt;每客户端限速 ~20fps；传感器/编码仍跑满 80fps。" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="580" width="520" height="210" as="geometry" /></mxCell><mxCell id="_n41" value="验收操作&lt;br&gt;&lt;br&gt;1. 通电等 15 秒&lt;br&gt;2. 浏览器打开上面任一地址&lt;br&gt;3. 放绿色目标 → 画面出现白框&lt;br&gt;4. SSH: tail -f /tmp/fly_licheerv_capture.log&lt;br&gt;   看 GREEN_TARGET / host_fps&lt;br&gt;&lt;br&gt;停止：sh stop.sh（勿 kill -9，会残留 VPSS）" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1075" y="810" width="520" height="240" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="5-问题定位与修复" name="5-问题定位与修复"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="_title" value="「原来到底是什么问题」— 诊断树与修复对照" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1574" height="34" as="geometry" /></mxCell><mxCell id="_sub" value="从 33.7fps / 全绿 到 1280x720 @ 80fps：错误假设、证据、根因、修复" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontColor=#1a1a1a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1574" height="24" as="geometry" /></mxCell><mxCell id="_band0" value="症状 → 排查 → 根因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#b85450;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1580" height="520" as="geometry" /></mxCell><mxCell id="_band1" value="两版驱动对照 + 修复动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#82b366;spacingLeft=8;spacingTop=2;dashed=0;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="1580" height="450" as="geometry" /></mxCell><mxCell id="q0" value="症状&lt;br&gt;1280x720 输出&lt;br&gt;但只有 33.7fps / 全绿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="260" height="66" as="geometry" /></mxCell><mxCell id="q1" value="错误假设 ①&lt;br&gt;「加了检测算法变慢」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="260" height="66" as="geometry" /></mxCell><mxCell id="q2" value="错误假设 ②&lt;br&gt;「硬件像素吞吐到上限」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="225" width="260" height="66" as="geometry" /></mxCell><mxCell id="q3" value="错误假设 ③&lt;br&gt;「Sipeed 720P 寄存器表闭源」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="320" width="260" height="66" as="geometry" /></mxCell><mxCell id="q4" value="错误假设 ④&lt;br&gt;「80fps 靠 devmem 36MHz 超频」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="370" y="415" width="260" height="66" as="geometry" /></mxCell><mxCell id="_e0" value="猜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e1" value="猜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q0" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e2" value="猜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q0" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_e3" value="猜" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;strokeColor=#b85450;strokeWidth=2;dashed=1;dashPattern=6 4;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q0" target="q4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="_n0" value="证伪：加 detect_enable 开关做 A/B → 检测 on 33.83fps / off 33.69fps，差 0.14fps。检测不是瓶颈（DETECT 仅 5.3ms）。" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="900" height="66" as="geometry" /></mxCell><mxCell id="_n1" value="证伪：原版 VI=1280x720 能跑 82.47fps。真正差异是「VI 输出尺寸」，不是像素总量上限；而且检测开/关帧率相同。" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="225" width="900" height="66" as="geometry" /></mxCell><mxCell id="_n2" value="证伪：kalapaopao/LicheeRV-Nano-GC4653 仓库以及本机 gc4653_36mhz_80fps_20261019/ 里就有完整用户态驱动源码，一直开源。" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="320" width="900" height="66" as="geometry" /></mxCell><mxCell id="_n3" value="证伪：生产版驱动 sensor_rx_attr() 里 MAIX_SENSOR_FPS&gt;=80 → CAMPLL_FREQ_37P125M；60 × 37.125/27 = 82.5fps。devmem 不是主因。" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="415" width="900" height="66" as="geometry" /></mxCell><mxCell id="_n4" value="真正根因：我拿的是「实验版」驱动（test/ 目录，为 RAW 抓取把 720P 模式改成了 1920x1080 输出），而不是「生产版」驱动（10 月 7 日目录，720P 模式真正输出 1280x720）。传感器吐 1920x1080、下游按 720P 配 → Bayer 相位错位（全绿）+ 像素量翻倍（33.7fps）。" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="500" width="1525" height="80" as="geometry" /></mxCell><mxCell id="_n5" value="对比项" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="655" width="470" height="34" as="geometry" /></mxCell><mxCell id="_n6" value="生产版（正确）" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="535" y="655" width="480" height="34" as="geometry" /></mxCell><mxCell id="_n7" value="我误用的实验版" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1025" y="655" width="555" height="34" as="geometry" /></mxCell><mxCell id="_n8" value="源码位置" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="695" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n9" value="gc4653_36mhz_80fps_20261019/&lt;br&gt;workspace/camera/src/" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="695" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n10" value="test/clock36_safe_20261019/userland/" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="695" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n11" value="GetSize(720P)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="741" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n12" value="PIC_720P" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="741" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n13" value="PIC_1080P" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="741" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n14" value="PIC_720P 尺寸" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="787" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n15" value="1280 x 720" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="787" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n16" value="1920 x 1080" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="787" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n17" value="模式表 stSnsSize" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="833" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n18" value="1280 x 720" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="833" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n19" value="1920 x 1080" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="833" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n20" value="720p 窗口寄存器" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="879" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n21" value="0x034c=0x05, 0x034e=0x02,&lt;br&gt;0x034f=0xd0 …" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="879" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n22" value="0x0344=0x02 0x0345=0x86 …&lt;br&gt;(0x0780 x 0x0438 = 1080p 窗口)" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="879" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n23" value="MCLK 选择" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="925" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n24" value="MAIX_SENSOR_FPS&gt;=80&lt;br&gt;→ 37.125MHz" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="925" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n25" value="默认 27MHz（实验表）" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="925" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n26" value="VI geometry" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="971" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n27" value="1280x720" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="971" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n28" value="1920x1080" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="971" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n29" value="实测结果" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="1017" width="470" height="42" as="geometry" /></mxCell><mxCell id="_n30" value="80.08fps / 颜色正常" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="535" y="1017" width="480" height="42" as="geometry" /></mxCell><mxCell id="_n31" value="33.7fps / 或 67fps 但全绿" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1025" y="1017" width="555" height="42" as="geometry" /></mxCell><mxCell id="_n32" value="" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;" vertex="1" parent="1"><mxGeometry x="55" y="1070" width="1525" height="0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>