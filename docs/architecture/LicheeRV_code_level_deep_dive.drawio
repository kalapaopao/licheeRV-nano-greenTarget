        <mxCell id="b1" value="借：CVI_VI_GetChnFrame()   L321&lt;br&gt;只有这 1 处借" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
