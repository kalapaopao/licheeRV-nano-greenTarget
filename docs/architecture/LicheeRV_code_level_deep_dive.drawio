          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e14" edge="1" parent="1" source="venc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" target="out3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e15" edge="1" parent="1" source="out2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" target="rel" value="编码完成后">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_n0" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="硬件把 Bayer RAW 经 MIPI 送入 VI；VI/ISP 在硬件里完成去马赛克、&lt;br&gt;曝光增益、转成 NV21，然后 DMA 直写 DRAM" vertex="1">
          <mxGeometry height="40" width="360" x="40" y="196" as="geometry" />
        </mxCell>
        <mxCell id="_n1" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="★ 关键：只有 8 块，循环使用。&lt;br&gt;借走不还 → 8 块耗尽 → 摄像头无处可写 → 丢帧。&lt;br&gt;这就是「帧是借来的」的物理原因。" vertex="1">
          <mxGeometry height="96" width="360" x="40" y="446" as="geometry" />
        </mxCell>
        <mxCell id="_n2" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="为什么必须抽点（后面详述）&lt;br&gt;921600 次字节读取，在 1GHz 单核上&lt;br&gt;未缓存映射要 223ms/帧；&lt;br&gt;缓存映射 28ms；再抽点降到 4.5ms。&lt;br&gt;帧预算只有 12.5ms（80fps）。" vertex="1">
          <mxGeometry height="150" width="360" x="40" y="560" as="geometry" />
        </mxCell>
        <mxCell id="_n3" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="实测（板端日志）&lt;br&gt;POOL_SIZE 1280x720 sys_init_rc=0&lt;br&gt;VI geometry=1280x720 stride=1280,1280&lt;br&gt;           format=19(NV21) length=921600,460800&lt;br&gt;stSnsrMode 1280 720 60.000000&lt;br&gt;host_fps 80.08  pts_fps 80.08" vertex="1">
          <mxGeometry height="220" width="360" x="40" y="730" as="geometry" />
        </mxCell>
        <mxCell id="_n4" parent="1" style="text;html=1;strokeColor=#3d8b8b;fillColor=#d5f0f0;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="mmap 到底做了什么&lt;br&gt;① 内核在该进程页表里加一条：&lt;br&gt;   虚拟地址 0x3ff09b7000 → 物理 0x8ace8000&lt;br&gt;② 标记为 cached（走 L1/L2）&lt;br&gt;③ 返回虚拟地址&lt;br&gt;本质：改页表。只有内核能做，故须系统调用。" vertex="1">
          <mxGeometry height="130" width="360" x="470" y="368" as="geometry" />
        </mxCell>
        <mxCell id="_n5" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="Mmap  vs  MmapCache（实测差 8 倍）&lt;br&gt;Mmap      uncached：每次字节访问走总线&lt;br&gt;          → 检测 223 ms/帧（4 fps）&lt;br&gt;MmapCache cached  ：一次搬 64B 缓存行&lt;br&gt;          → 检测 28 ms/帧&lt;br&gt;+ 抽点后 → 5.3 ms/帧（80 fps）&lt;br&gt;代码：src/camera.cpp L45-52" vertex="1">
          <mxGeometry height="176" width="360" x="470" y="512" as="geometry" />
        </mxCell>
        <mxCell id="_n6" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" value="自己实现的映射缓存表（L42-52）&lt;br&gt;struct VaCache { CVI_U64 phy; unsigned len;&lt;br&gt;                 unsigned char* va; };&lt;br&gt;static VaCache g_va[16];&lt;br&gt;命中：直接返回 va（零系统调用）&lt;br&gt;未命中：MmapCache 后写入表&lt;br&gt;实测 g_map_miss = 16（全程只映射 16 次，&lt;br&gt;因为 VB 池只有 8 块 ×(Y+UV) )" vertex="1">
          <mxGeometry height="190" width="360" x="470" y="700" as="geometry" />
        </mxCell>
        <mxCell id="_n7" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=True;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;spacing=3;" value="camera 进程：一个 main()，4 类线程，共享同一份内存" vertex="1">
          <mxGeometry height="44" width="1040" x="900" y="100" as="geometry" />
        </mxCell>
        <mxCell id="_n8" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" value="返回 VIDEO_FRAME_INFO_S&lt;br&gt;u64PhyAddr[0..2] 物理地址（有值）&lt;br&gt;pu8VirAddr[0..2] 虚拟地址（NULL！）" vertex="1">
          <mxGeometry height="66" width="340" x="1215" y="158" as="geometry" />
        </mxCell>
        <mxCell id="_n9" parent="1" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="DETECT sample_ms = 4.49&lt;br&gt;占帧预算 12.5ms 的 36%&lt;br&gt;输出 gy[320*180] gu/gv[160*90]" vertex="1">
          <mxGeometry height="66" width="340" x="1215" y="312" as="geometry" />
        </mxCell>
        <mxCell id="_n10" parent="1" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="track_ms = 0.80&lt;br&gt;（算法本身极轻）" vertex="1">
          <mxGeometry height="56" width="340" x="1215" y="394" as="geometry" />
        </mxCell>
        <mxCell id="_n11" parent="1" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="★ cached 映射的坑：&lt;br&gt;CPU 改动在 L1/L2，VENC 读物理内存&lt;br&gt;不 flush → 网页上看不到框" vertex="1">
          <mxGeometry height="56" width="340" x="1215" y="538" as="geometry" />
        </mxCell>
        <mxCell id="_n12" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="★ 所有权转移点&lt;br&gt;此后这块 VB 由编码线程负责归还&lt;br&gt;交接台深度=1，新帧覆盖旧帧" vertex="1">
          <mxGeometry height="66" width="340" x="1215" y="610" as="geometry" />
        </mxCell>
        <mxCell id="_n13" parent="1" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=True;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;spacing=3;" value="编码线程（消费者，display_enable 控制是否启动）" vertex="1">
          <mxGeometry height="44" width="380" x="1560" y="100" as="geometry" />
        </mxCell>
        <mxCell id="_n14" parent="1" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="1.8MB 原始 → 约 0.1MB JPEG&lt;br&gt;硬件专用电路，不占 CPU" vertex="1">
          <mxGeometry height="56" width="300" x="1600" y="320" as="geometry" />
        </mxCell>
        <mxCell id="_n15" parent="1" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" value="★ 一份 JPEG 三处复用：&lt;br&gt;录像 / 网页 / 抓图 不做第二次编码&lt;br&gt;latest.swap(jpg) 只换指针，O(1)" vertex="1">
          <mxGeometry height="70" width="340" x="1560" y="468" as="geometry" />
        </mxCell>
