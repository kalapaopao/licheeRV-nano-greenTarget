        <mxCell id="_n5" value="if(t-start&lt;4){ Release; continue; }  —— ISP 还没稳定" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
