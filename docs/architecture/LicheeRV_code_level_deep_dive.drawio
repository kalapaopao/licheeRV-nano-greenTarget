        </mxCell>
        <mxCell id="_n7" value="VI geometry=... strides / lengths / format" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="320" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n8" value="L383" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="384" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n9" value="if(u64PTS &lt;= lastpts) ++dups;  用 PTS 判重" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="384" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n10" value="L390-395" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="448" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n11" value="长度优先用 u32Length[]，取不到才 stride*H" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="448" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n12" value="L397-430" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="512" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n13" value="S=4；块内 ns×ns 取 max；ry/cx 越界 break" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="512" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n14" value="L434" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="576" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n15" value="返回 const TrackState&amp;（内部已是三态机）" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="576" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n16" value="L437-456" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n17" value="cx,cy,r × S 映射回全分辨率；3px；clamp 到 [0,W-1]" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="640" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n18" value="L453 / L468" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="704" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n19" value="IonFlushCache(phy, va, stride*H) 写回 DRAM" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="704" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n20" value="L484-490" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="768" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n21" value="display_on → pending=frame；否则 Release" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="768" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n22" value="L492-497" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="832" width="190" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n23" value="capture_frames / host_fps / DETECT / CLOCK36_WINDOW" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="825" y="832" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="_n24" value="为什么第 3 步要丢前 4 秒：ISP 的 AE/AWB 需要几十帧收敛。前 4 秒画质与曝光都不稳定，&lt;br&gt;如果此时就把帧交给检测/编码，会看到&quot;忽明忽暗&quot;且白平衡在漂。" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="45" y="900" width="1150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="_n25" value="耗时分解（NS=1，板端实测）&lt;br&gt;  采样   sample_ms = 4.49   (36.0%)&lt;br&gt;  算法   track_ms  = 0.80   ( 6.4%)&lt;br&gt;  画框   +flush    ≈ 0.1~0.2 ( 1.6%)&lt;br&gt;  ─────────────────────────────&lt;br&gt;  CPU 合计         ≈ 5.3 ms  (42%)&lt;br&gt;  等摄像头          7.2 ms  (58%)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1255" y="128" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="_n26" value="三个 YAML 开关改变路径&lt;br&gt;detect_enable=false&lt;br&gt;  跳过 7~9 步 → 纯取流，实测仍 80fps（证明检测不是瓶颈）&lt;br&gt;display_enable=false&lt;br&gt;  不创建 VENC/编码线程/HTTP；第 11 步直接 Release&lt;br&gt;detect_stride=N&lt;br&gt;  每 N 帧才做 7~9 步（N=2 时检测 40 次/秒）" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1255" y="292" width="690" height="170" as="geometry" />
        </mxCell>
        <mxCell id="_n27" value="采样密度 ↔ 实测帧率（这是唯一真正的取舍）&lt;br&gt;ns=1  DETECT 5.3ms   80.0 fps  ✅ 当前默认&lt;br&gt;ns=2  DETECT 11.0ms  47.7 fps&lt;br&gt;ns=2 + 画框 12.8ms   40.0 fps&lt;br&gt;ns=4  DETECT 27ms    20.5 fps&lt;br&gt;原因：ns 越大命中绿像素越多，连通域计算量线性上升。&lt;br&gt;ns=1 覆盖率仅 1/16 → 远处小目标可能漏检（已知限制）" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1255" y="476" width="690" height="210" as="geometry" />
        </mxCell>
        <mxCell id="_n28" value="两个越界保护（缺了会段错误，实测崩过）&lt;br&gt;if (ry &gt;= y_rows) break;   // 行越界&lt;br&gt;if (cx &gt;= W) break;        // 列越界&lt;br&gt;y_rows = u32Length[0] / u32Stride[0]&lt;br&gt;崩塌现象：dmesg 里 cause: 0x0d（页错误），&lt;br&gt;之后残留 ION/VB → 下次启动 vi_sdk_enable_chn OOM&lt;br&gt;→ 只能重启板子" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1255" y="700" width="690" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
