        </mxCell>
        <mxCell id="b4" value="编码线程持有&lt;br&gt;取帧 → VENC → 三路输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="572" width="520" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="还：CVI_VI_ReleaseChnFrame()   L186&lt;br&gt;由编码线程执行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="668" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tl0" value="主线程：GetChnFrame 借到块2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="160" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl1" value="主线程：map / 抽点 / 检测 / 画框 / flush" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="222" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl2" value="主线程：pending=frame（转移）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="284" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl3" value="主线程立刻回去借下一块（块3）  ← 并发点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="346" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl4" value="编码线程：取块2 → VENC 编码" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="408" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl5" value="编码线程：三路输出（网页/抓图/录像）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="470" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl6" value="编码线程：Release 块2  → 归还" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="532" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tl7" value="摄像头可以把块2 拿去写新画面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="594" width="660" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="L381  前 4 秒直接丢&lt;br&gt;if(t-start&lt;4){ Release; continue; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1340" y="164" width="600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="L489  display_enable=false&lt;br&gt;没有消费者，主线程当场归还" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1340" y="246" width="600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="L486  交接台被顶掉的旧帧&lt;br&gt;if(has_pending){ Release(&amp;pending); }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1340" y="328" width="600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="L190  编码线程退出前清理&lt;br&gt;残留的 pending 帧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1340" y="410" width="600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="L501  主循环结束后统一清理&lt;br&gt;保证不泄漏" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1340" y="492" width="600" height="66" as="geometry" />
        </mxCell>
        <mxCell id="_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e4" value="块2 回到空闲池" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontColor=#82b366;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="b5" target="vb1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl0" target="tl1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl1" target="tl2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl2" target="tl3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl3" target="tl4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl4" target="tl5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl5" target="tl6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tl6" target="tl7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_n0" value="8 块内存，摄像头循环往里写新画面" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="520" height="34" as="geometry" />
        </mxCell>
        <mxCell id="_n1" value="块2 = 正在被处理的那一块&lt;br&gt;（下面所有步骤都是围绕这一块）" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="_n2" value="为什么交接台只有 1 个位置&lt;br&gt;若排队：编码线程稍慢，队列越积越长，&lt;br&gt;你看到的画面会比现实晚好几秒。&lt;br&gt;深度 1 + 覆盖 = 宁丢旧帧，不积延迟。&lt;br&gt;被顶掉的旧帧在 L486 当场归还，&lt;br&gt;并 ++preview_replaced（日志可见，实测 0）" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="748" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="_n3" value="时间轴（t 增加向下）" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="660" height="34" as="geometry" />
        </mxCell>
        <mxCell id="_n4" value="★ 关键：主线程不会等编码完成。&lt;br&gt;它把帧放到交接台就立刻回去借下一块，&lt;br&gt;所以摄像头和编码线程是真正并行工作的。&lt;br&gt;这就是&quot;主线程只忙 5.3ms 却能跑 80fps&quot;的原因。" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="_n5" value="若编码线程跟不上（VENC 卡顿 / TF 卡慢）&lt;br&gt;→ 交接台上的帧被新帧顶掉&lt;br&gt;→ L486 归还旧帧 + ++preview_replaced&lt;br&gt;→ 画面丢帧但采集与检测不受影响&lt;br&gt;（这是设计意图：宁可丢显示帧，不拖慢采集）" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="620" y="810" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="_n6" value="这 5 处也要归还，否则同样耗尽 VB 池" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1340" y="120" width="600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="_n7" value="工程原则：&lt;br&gt;「借」只有 1 处，「还」有 6 处 ——&lt;br&gt;每个提前退出（continue / return / 退出循环）&lt;br&gt;都必须配一次 Release。&lt;br&gt;漏掉任何一处都会造成 VB 泄漏。" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1340" y="590" width="600" height="130" as="geometry" />
        </mxCell>
        <mxCell id="_n8" value="如果漏了会怎样（可观测症状）&lt;br&gt;① preview_replaced 持续增长 → 覆盖型泄漏&lt;br&gt;② 几秒后 CVI_VI_GetChnFrame 超时增长&lt;br&gt;③ 日志 timeouts 变多、host_fps 掉&lt;br&gt;④ 最终 vi_sdk_enable_chn NG, Out of memory&lt;br&gt;   （因为池子彻底空了，且上次未清理）&lt;br&gt;排查手段：看 timeouts / preview_replaced 两个计数" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1340" y="736" width="600" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="13_线程同步与检测算法" name="13_线程同步与检测算法">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_t" value="④ 线程/同步原语 与 检测算法内部" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;spacing=3;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="8" width="1920" height="34" as="geometry" />
        </mxCell>
        <mxCell id="_s" value="4 类线程共用 3 个原语；算法 5 步 + 三态机；全部为纯 CPU 整数运算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;spacing=3;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="42" width="1920" height="24" as="geometry" />
        </mxCell>
        <mxCell id="_b0" value="线程与同步（代码级）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=3;fontColor=#9673a6;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="620" height="900" as="geometry" />
        </mxCell>
        <mxCell id="_b1" value="检测算法流水线" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=3;fontColor=#d79b00;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="700" height="900" as="geometry" />
        </mxCell>
        <mxCell id="_b2" value="门控/跳变/三态 与 参数" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontSize=13;fontStyle=1;spacingLeft=8;spacingTop=3;fontColor=#d6b656;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="1380" y="80" width="580" height="900" as="geometry" />
        </mxCell>
        <mxCell id="th1" value="主线程（main 内 while 循环）&lt;br&gt;L319-498  取帧/检测/画框" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="128" width="580" height="66" as="geometry" />
        </mxCell>
        <mxCell id="th2" value="encoder_worker()&lt;br&gt;L158-191  VENC 编码 + AVI + latest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="580" height="66" as="geometry" />
        </mxCell>
        <mxCell id="th3" value="http_server()&lt;br&gt;L133-157  accept + 4 个槽位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="292" width="580" height="66" as="geometry" />
        </mxCell>
        <mxCell id="th4" value="http_client() × ≤4&lt;br&gt;L86-131  每连接一线程，MJPEG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="374" width="580" height="66" as="geometry" />
        </mxCell>
        <mxCell id="sy1" value="std::atomic&lt;int&gt; running(1)&lt;br&gt;所有线程的退出标志；信号处理器写 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="618" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="sy2" value="std::mutex input_mutex&lt;br&gt;保护 pending / has_pending（帧交接）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="678" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="sy3" value="std::mutex jpeg_mutex&lt;br&gt;保护 latest / generation（最新 JPEG）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="738" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="sy4" value="generation（unsigned long）&lt;br&gt;HTTP 靠它判断&quot;有没有新帧&quot;，避免重复发" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="sy5" value="atomic 计数器&lt;br&gt;encoded / errors / network_bytes&lt;br&gt;preview_replaced" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="858" width="580" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="输入：gy[320×180] 亮度  gu/gv[160×90] 色度&lt;br&gt;（NV21 的 UV 交织已拆成两个平面）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="128" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="① buildMask  L21-66&lt;br&gt;Y&gt;y_min(100) &amp;&amp; U&lt;124 &amp;&amp; V&lt;124&lt;br&gt;&amp;&amp; sat=√(du²+dv²)&gt;=30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="206" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="② n==0 且正在跟踪 → 回退掩膜（更松阈值）&lt;br&gt;仅限门控圆内，防满屏误检" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="284" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="③ morphOpen  L71-117&lt;br&gt;3×3 开运算 = 先腐蚀后膨胀，去孤立噪点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="362" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="④ 连通域  L147-197&lt;br&gt;显式栈泛洪，8 邻域；&lt;br&gt;同时统计 area / bbox / 重心" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="⑤ 形状过滤  L199-230&lt;br&gt;area 2..400  fill&gt;=0.5&lt;br&gt;aspect 0.45..2.2  radius&lt;=12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="518" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="⑥ 评分选优  L232-260&lt;br&gt;score = 亮度 + 饱和度 − 距离权重" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="596" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="⑦ TrackState 输出&lt;br&gt;status / cx / cy / vx / vy / misses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;verticalAlign=middle;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="680" y="674" width="660" height="66" as="geometry" />
        </mxCell>
        <mxCell id="st1" value="kDetected  命中&lt;br&gt;输出坐标，misses=0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1400" y="128" width="540" height="56" as="geometry" />
        </mxCell>
        <mxCell id="st2" value="kCoast  跟丢但未超时&lt;br&gt;按速度预测，继续输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1400" y="220" width="540" height="56" as="geometry" />
        </mxCell>
        <mxCell id="st3" value="kLost  跟丢超过 coast_frames&lt;br&gt;停止输出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1400" y="312" width="540" height="56" as="geometry" />
        </mxCell>
        <mxCell id="_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="a7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a7" target="a8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e7" value="未命中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e8" value="重新命中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st2" target="st1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e9" value="misses &gt; 20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444;strokeWidth=2;fontSize=9;fontColor=#444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_e10" value="首次命中" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=9;fontColor=#82b366;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="st3" target="st1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_n0" value="启动方式（L305-310）&lt;br&gt;std::thread server_thread;&lt;br&gt;std::thread encoder_thread;&lt;br&gt;if (g_display_on) {&lt;br&gt;    server_thread = std::thread(http_server, server);&lt;br&gt;    encoder_thread = std::thread(encoder_worker);&lt;br&gt;}&lt;br&gt;display_enable=false → 这两个线程根本不创建" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="_n1" value="static_assert(ATOMIC_INT_LOCK_FREE==2)：信号处理器里必须无锁" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="928" width="580" height="44" as="geometry" />
        </mxCell>
        <mxCell id="_n2" value="为什么在 YUV 域而不是 RGB/HSV&lt;br&gt;① 板端帧本来就是 NV21，转色彩空间要额外一次全图遍历&lt;br&gt;② 绿色等价判据：U&lt;128 &amp;&amp; V&lt;128（两者都小于中性值 128）&lt;br&gt;③ 该判据对 U/V 是否交换不敏感 → NV12/NV21 都能用&lt;br&gt;④ sat 与 HSV 的 S 等价：√((U-128)²+(V-128)²)" style="text;html=1;strokeColor=#999999;fillColor=#ffffff;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="680" y="720" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="_n3" value="为什么不用 OpenCV / NPU&lt;br&gt;① 纯整数阈值+连通域，NPU 无收益（不是卷积任务）&lt;br&gt;② 引入 OpenCV 会让二进制从 451KB 涨到数十 MB，&lt;br&gt;   且需交叉编译整套库；当前零第三方依赖&lt;br&gt;③ 实测算法仅 0.80ms，优化空间小" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="680" y="856" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_n4" value="三个参数各防一种问题（L272-338）&lt;br&gt;gate_px=28&lt;br&gt;  满屏绿色时只认预测位置附近；&lt;br&gt;  跟丢越久搜索圈越大×(1+0.3*misses)&lt;br&gt;max_jump_px=38&lt;br&gt;  突然出现远处绿点 → 不算命中，防&quot;瞬移&quot;&lt;br&gt;coast_frames=20&lt;br&gt;  短暂遮挡不立即报丢，下游不抖" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1400" y="386" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="_n5" value="速度平滑（L303-310）&lt;br&gt;vx = (1-0.3)*vx + 0.3*(new_cx - cx)&lt;br&gt;coast 期间速度衰减（L322-325）&lt;br&gt;cx += vx;  vx *= 0.8&lt;br&gt;→ 预测逐渐收敛，不会一直飞出去&lt;br&gt;&lt;br&gt;实测（无目标场景）&lt;br&gt;frames=2100  hits=0  rate=0.0%&lt;br&gt;→ 无误报，判据正常" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1400" y="552" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="_n6" value="未验证 / 已知限制（如实记录）&lt;br&gt;① 真实绿色目标在真实距离下的检出率：&lt;br&gt;   尚未验证（当前画面无目标，hits=0 正确）&lt;br&gt;② ns=1 时覆盖率仅 1/16，远处小灯可能漏检&lt;br&gt;③ 阈值 y_min=100 / sat_min=30 是按&lt;br&gt;   一张实拍帧（LED 处 Y=113 sat=38）校准的&lt;br&gt;④ 换环境/换曝光需重新校准" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;spacing=3;" vertex="1" parent="1">
          <mxGeometry x="1400" y="758" width="540" height="198" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
