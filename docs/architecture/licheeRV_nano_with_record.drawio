      <mxCell id="legend" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="【读图约定】色带 = 一个线程；框 = 步骤或文件&lt;br&gt;线程数：全关 1 ｜ 典型 5 ｜ 4 网页连满 9&lt;br&gt;②③=display_enable ④=uart_enable ⑤=log_enable" vertex="1"><mxGeometry height="90" width="368" x="350" y="-128" as="geometry" /></mxCell><mxCell id="mcu-box" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FDE9E0;strokeColor=#C55A11;rounded=1;arcSize=8;" value="电控 STM32（USART3 115200 8N1）&lt;br&gt;视觉→电控 28B@50Hz（目标角）&lt;br&gt;电控→视觉 33B@100Hz（STATE/姿态）&lt;br&gt;两路独立数据流，非「请求-应答」" vertex="1"><mxGeometry height="94" width="350" x="350" y="682" as="geometry" /></mxCell><mxCell id="uart-band" parent="1" style="whiteSpace=wrap;html=1;fontStyle=1;fillColor=#F4F0FA;strokeColor=#B4A0D0;rounded=0;arcSize=8;" value="" vertex="1"><mxGeometry height="300" width="350" x="350" y="780" as="geometry" /></mxCell><mxCell id="uart-title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;rounded=0;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#7030A0;" value="线程 ④ 串口线程（camera 进程内）" vertex="1"><mxGeometry height="26" width="330" x="360" y="786" as="geometry" /></mxCell><mxCell id="uart-s2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E8E1F2;strokeColor=#7030A0;rounded=1;arcSize=8;" value="poll 唤醒：数据到了立刻读（不是等 20ms）&lt;br&gt;解析完存快照 + 调 on_mcu" vertex="1"><mxGeometry height="55" width="326" x="362" y="900" as="geometry" /></mxCell><mxCell id="uart-s3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E8E1F2;strokeColor=#7030A0;rounded=1;arcSize=8;" value="主线程只读「最近一帧」快照&lt;br&gt;写进 frames.csv 的 mcu_* 列 / OSD" vertex="1"><mxGeometry height="55" width="326" x="362" y="965" as="geometry" /></mxCell><mxCell id="rec-band" parent="1" style="whiteSpace=wrap;html=1;fontStyle=1;fillColor=#F0F9FC;strokeColor=#8CC7D8;rounded=0;arcSize=8;" value="" vertex="1"><mxGeometry height="460" width="290" x="740" y="790" as="geometry" /></mxCell><mxCell id="rec-title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;rounded=0;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1F6F8B;" value="线程 ⑤ 记录器写线程" vertex="1"><mxGeometry height="26" width="274" x="748" y="796" as="geometry" /></mxCell><mxCell id="rec-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EAF6FA;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="→ 由主线程调用 on_frame()&lt;br&gt;每帧一行（32 列：视觉 + 电控 9 列）" vertex="1"><mxGeometry height="55" width="266" x="752" y="845" as="geometry" /></mxCell><mxCell id="rec-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EAF6FA;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="→ 由串口线程调用 on_mcu()&lt;br&gt;可选：额外存 100Hz 原始流（默认关）" vertex="1"><mxGeometry height="55" width="266" x="752" y="910" as="geometry" /></mxCell><mxCell id="rec-3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#D3ECF3;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="环形缓冲 2048 行（≈11s，预录 3s）&lt;br&gt;STATIC→FLIGHT 开段&lt;br&gt;FLIGHT→STOP 再记 2s 收尾" vertex="1"><mxGeometry height="78" width="266" x="752" y="975" as="geometry" /></mxCell><mxCell id="rec-4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EAF6FA;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="本线程：20ms / 64 行 write&lt;br&gt;每秒 fdatasync（采集线程不碰 I/O）" vertex="1"><mxGeometry height="60" width="266" x="752" y="1063" as="geometry" /></mxCell><mxCell id="rec-5" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EAF6FA;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="logs/sess_*/&lt;br&gt;frames.csv（含电控）· meta.txt&lt;br&gt;+ health_*.csv · video_frames_*.csv&lt;br&gt;分析：tools/flight_merge.py" vertex="1"><mxGeometry height="105" width="266" x="752" y="1133" as="geometry" /></mxCell><mxCell id="http-band" parent="1" style="whiteSpace=wrap;html=1;fontStyle=1;fillColor=#F1F8F6;strokeColor=#8FBFB3;rounded=0;arcSize=8;" value="" vertex="1"><mxGeometry height="170" width="460" x="1050" y="790" as="geometry" /></mxCell><mxCell id="http-title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;rounded=0;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#2E7D6B;" value="线程 ③ HTTP 预览线程" vertex="1"><mxGeometry height="26" width="440" x="1060" y="796" as="geometry" /></mxCell><mxCell id="http-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E6F4EE;strokeColor=#2E7D6B;rounded=1;arcSize=8;" value="服务线程：accept 连接，最多 4 个客户端槽（满了回 503）" vertex="1"><mxGeometry height="50" width="436" x="1062" y="833" as="geometry" /></mxCell><mxCell id="http-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#E6F4EE;strokeColor=#2E7D6B;rounded=1;arcSize=8;" value="客户端线程 ×4（每个网页连接 1 个）&lt;br&gt;MJPEG / 抓图，每客户端限 20fps" vertex="1"><mxGeometry height="55" width="436" x="1062" y="893" as="geometry" /></mxCell><mxCell id="diag-band" parent="1" style="whiteSpace=wrap;html=1;fontStyle=1;fillColor=#F6F3FA;strokeColor=#B4A6C9;rounded=0;arcSize=8;" value="" vertex="1"><mxGeometry height="270" width="460" x="1050" y="980" as="geometry" /></mxCell><mxCell id="diag-title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;rounded=0;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#60497A;" value="运行状态与退出归因（diag：不开线程）" vertex="1"><mxGeometry height="26" width="440" x="1060" y="986" as="geometry" /></mxCell><mxCell id="diag-1" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#60497A;rounded=1;arcSize=8;" value="print_* 9 个分类开关（默认全开，总开关 print_enable）" vertex="1"><mxGeometry height="42" width="436" x="1062" y="1022" as="geometry" /></mxCell><mxCell id="diag-2" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#60497A;rounded=1;arcSize=8;" value="state/run_history.log&lt;br&gt;supervisor_start → start → ready → alive(30s) → exit / crash" vertex="1"><mxGeometry height="52" width="436" x="1062" y="1072" as="geometry" /></mxCell><mxCell id="diag-3" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#60497A;rounded=1;arcSize=8;" value="崩溃处理器：信号号 + 帧数 + 温度（只 open/write）" vertex="1"><mxGeometry height="42" width="436" x="1062" y="1132" as="geometry" /></mxCell><mxCell id="diag-4" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EFEAF5;strokeColor=#60497A;rounded=1;arcSize=8;" value="孤儿保护 PR_SET_PDEATHSIG + status.sh 一条命令复核" vertex="1"><mxGeometry height="42" width="436" x="1062" y="1182" as="geometry" /></mxCell><mxCell id="vs-box" parent="1" style="whiteSpace=wrap;html=1;fillColor=#EAF6FA;strokeColor=#1F6F8B;rounded=1;arcSize=8;" value="video_frames_*.csv&lt;br&gt;AVI 第 k 帧 → frame_id" vertex="1"><mxGeometry height="50" width="176" x="1240" y="600" as="geometry" /></mxCell><mxCell id="osd-note" parent="1" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A6A6A6;rounded=0;arcSize=8;" value="④b OSD（可选）：编码前把电控状态烧进 Y 平面&lt;br&gt;→ 网页 / 录像 / 抓图都能看到" vertex="1"><mxGeometry height="34" width="250" x="770" y="704" as="geometry" /></mxCell><mxCell id="e-main-rec" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#1F6F8B;strokeWidth=2;" edge="1" source="pKCW-2MlPlMVXdzMdy-7-49" target="rec-1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-uart-rec" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#1F6F8B;strokeWidth=2;" edge="1" source="uart-s3" target="rec-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-uart-mcu" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#C55A11;strokeWidth=2;" edge="1" source="uart-thread-1" target="mcu-box"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e-uart-2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;strokeColor=#7030A0;strokeWidth=2;" edge="1" source="uart-thread-1" target="